{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksConfigPath": "nixpacks.toml",
        "watchPatterns": [
            "apps/web/**",
            "packages/**"
        ]
    },
    "deploy": {
        "numReplicas": 1,
        "startCommand": "cd apps/web && pnpm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}