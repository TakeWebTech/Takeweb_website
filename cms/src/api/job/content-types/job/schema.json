{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "department": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": ["FULL_TIME", "PART_TIME", "CONTRACT", "INTERNSHIP"],
      "default": "FULL_TIME"
    },
    "minSalary": {
      "type": "integer"
    },
    "maxSalary": {
      "type": "integer"
    },
    "description": {
      "type": "richtext"
    },
    "requirements": {
      "type": "richtext"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "deadline": {
      "type": "date"
    },
    "isRemote": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
