    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "icon": {
      "type": "string"
    },
    "gradient": {
      "type": "string"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "technologies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
